# Disk Health MCP - Environment Variables
# Copy to .env next to config.yaml, or export them in the MCP client config.
# Environment variables override values from config.yaml.

# DISK_HEALTH_MCP_CONFIG=~/.config/disk-health-mcp/config.yaml
MCP_LOG_LEVEL=INFO
# Top-level setting (not a nested YAML section)
# EXECUTOR=ssh
# CONTAINER_RUNTIME only applies to remote-server-mcp.

# SSH connection to target host
SSH_HOST=your-server.example.com
SSH_PORT=22
SSH_USERNAME=your-user
SSH_KEY_PATH=~/.ssh/id_ed25519
SSH_KNOWN_HOSTS=~/.ssh/known_hosts

# InfluxDB (optional - preferred source for historical SMART data)
# Two supported modes:
#   a) HTTPS reverse proxy (SWAG, Caddy, nginx): host without scheme, use_https=true
#   b) loopback-only service: keep a local SSH tunnel open (or use influxdb.ssh_tunnel)
# INFLUXDB_HOST=influxdb.example.com
# INFLUXDB_PORT=443
# INFLUXDB_USE_HTTPS=true
# INFLUXDB_DATABASE=my-db
# INFLUXDB_TOKEN=your-read-only-token

# Prometheus (optional; not required for disk health)
# smartmon_* metrics exist only when node_exporter has the smartmon collector.
# Telegraf -> InfluxDB is the recommended path for SMART history.
# PROMETHEUS_HOST=prometheus.example.com
# PROMETHEUS_PORT=443
# PROMETHEUS_USE_HTTPS=true
# PROMETHEUS_TOKEN=your-read-only-token

# Output/audit (optional)
# OUTPUT_MAX_BYTES=64000
# AUDIT_ENABLED=true
# AUDIT_LOG_PATH=~/.local/state/disk-health-mcp/audit.jsonl
