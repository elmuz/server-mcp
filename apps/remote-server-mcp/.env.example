# Environment variables for Remote Server MCP
# Copy to .env next to config.yaml, or export them in the MCP client config.
# Environment variables override values from config.yaml.

# Config file location (optional; otherwise XDG or ./config.yaml is used)
# REMOTE_SERVER_MCP_CONFIG=~/.config/remote-server-mcp/config.yaml

# MCP server settings
MCP_LOG_LEVEL=INFO
# Top-level settings (not nested YAML sections)
# EXECUTOR=ssh
# CONTAINER_RUNTIME=docker

# SSH credentials (alternative to config.yaml)
SSH_HOST=your-server.example.com
SSH_PORT=22
SSH_USERNAME=your-username
# SSH_PASSWORD=your-password
SSH_KEY_PATH=~/.ssh/id_ed25519
SSH_KNOWN_HOSTS=~/.ssh/known_hosts

# InfluxDB / Prometheus (optional)
# Two supported modes:
#   a) HTTPS reverse proxy (SWAG, Caddy, nginx): host without scheme, use_https=true
#   b) loopback-only service: keep a local SSH tunnel open (or use influxdb.ssh_tunnel)
# INFLUXDB_HOST=influxdb.example.com
# INFLUXDB_PORT=443
# INFLUXDB_USE_HTTPS=true
# INFLUXDB_DATABASE=my-db
# INFLUXDB_TOKEN=your-read-only-token
# PROMETHEUS_HOST=prometheus.example.com
# PROMETHEUS_PORT=443
# PROMETHEUS_USE_HTTPS=true
# PROMETHEUS_TOKEN=your-read-only-token

# Output/audit (optional)
# OUTPUT_MAX_BYTES=64000
# AUDIT_ENABLED=true
# AUDIT_LOG_PATH=~/.local/state/remote-server-mcp/audit.jsonl
