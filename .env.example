# Disk Health MCP - Environment Variables
# Copy to .env next to config.yaml, or export them in the MCP client config.
# Environment variables override values from config.yaml.

# DISK_HEALTH_MCP_CONFIG=~/.config/disk-health-mcp/config.yaml
MCP_LOG_LEVEL=INFO

# SSH connection to target host
SSH_HOST=your-server.example.com
SSH_PORT=22
SSH_USERNAME=your-user
SSH_KEY_PATH=~/.ssh/id_ed25519
SSH_KNOWN_HOSTS=~/.ssh/known_hosts

# InfluxDB (optional - for historical disk metrics)
# INFLUXDB_HOST=localhost
# INFLUXDB_PORT=8181
# INFLUXDB_DATABASE=telegraf
# INFLUXDB_TOKEN=your-read-only-token

# Prometheus (optional - for node_exporter disk metrics)
# PROMETHEUS_HOST=localhost
# PROMETHEUS_PORT=9090
# PROMETHEUS_TOKEN=your-read-only-token

# Output/audit (optional)
# OUTPUT_MAX_BYTES=64000
# AUDIT_ENABLED=true
# AUDIT_LOG_PATH=~/.local/state/disk-health-mcp/audit.jsonl
