# Secrets for the containerized MCP services.
#
# Installed at ~/.config/server-mcp/.env (mode 0600) and mounted read-only at
# /etc/server-mcp/.env. The HTTP bearer token is NOT stored here; it lives in
# ~/.config/server-mcp/secrets/http-token.
#
# Optional metric credentials:
# INFLUXDB_TOKEN=...
# PROMETHEUS_TOKEN=...
